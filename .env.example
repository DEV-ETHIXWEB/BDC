# Copy to .env for local work. Names only; never commit real values.
# All PUBLIC_* values are embedded in the browser bundle. Never put a secret in a PUBLIC_ variable.

# Form service endpoint (Formspree, Basin, Getform, ...). REQUIRED for launch: without it the booking form can only
# open the visitor's mail app and cannot confirm delivery.
PUBLIC_FORM_ENDPOINT=

# Optional. Set to 1 on the production host to make the build FAIL if PUBLIC_FORM_ENDPOINT is missing.
# By default a missing endpoint only prints a warning; the forms then say "not sent yet" and open the mail app.
REQUIRE_FORM_ENDPOINT=

# Set to 1 on non-Vercel staging deployments: adds noindex and a disallow-all robots.txt.
# (Vercel Preview deployments are noindex automatically.)
PUBLIC_NOINDEX=

# Cloudflare Turnstile SITE key (public, safe in the browser bundle). Unset = no captcha is rendered and the
# CSP stays closed to challenges.cloudflare.com. Setting it turns the widget on in all three forms.
PUBLIC_TURNSTILE_SITE_KEY=

# The Turnstile SECRET key is NOT listed here on purpose. It must live on the server/function that receives the
# lead and POSTs the token to https://challenges.cloudflare.com/turnstile/v0/siteverify. Never give it a
# PUBLIC_ prefix: PUBLIC_* values are compiled into the browser bundle. The build fails if it detects one.

# ---------------------------------------------------------------------------------------------------
# Lead delivery (api/lead.js -> SMTP2GO). Set PUBLIC_FORM_ENDPOINT=/api/lead to use it.
# ---------------------------------------------------------------------------------------------------

# SERVER ONLY. Never rename this with a PUBLIC_ prefix: the build fails if you do, because PUBLIC_* values
# are compiled into the browser bundle where anyone can read them.
SMTP2GO_API_KEY=

# Who the lead goes to, and who is copied. Comma separated. The defaults in api/lead.js are used if unset.
LEAD_TO=
LEAD_CC=

# The From address. Its DOMAIN must be a verified sender domain in SMTP2GO, otherwise every send is rejected.
MAIL_FROM=

# Where replies to the visitor's confirmation email go. Defaults to the first LEAD_TO address.
REPLY_TO=

# SERVER ONLY. Cloudflare Turnstile secret, pairs with PUBLIC_TURNSTILE_SITE_KEY above. While this is unset
# the captcha is not enforced on the server.
TURNSTILE_SECRET_KEY=

# Hostnames the Turnstile token may come from, comma separated. siteverify returns the hostname the widget
# ran on; anything else is a replayed token from another site. Defaults to the two bdcguideservices.com hosts.
# Never add localhost here on production.
TURNSTILE_ALLOWED_HOSTNAMES=

# The public origin the site is served from. Drives canonical URLs, og:url, JSON-LD and the sitemap.
# Defaults to https://www.bestdayscatching.com. Change it here (or in the host) if the domain moves.
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------------------------------
# Google reviews (api/reviews.js). Both unset = the reviews page keeps its "email us a review" invite.
# ---------------------------------------------------------------------------------------------------

# SERVER ONLY. Google Maps Platform key, restricted to the Places API. Never give it a PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=

# The business's Google Place ID (looks like ChIJ...). Find it with Google's Place ID Finder.
GOOGLE_PLACE_ID=
