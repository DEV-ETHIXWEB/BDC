---
import '../styles/partners.css';
import { PARTNERS } from '../data/partners';

interface Props {
  title?: string;
  lede?: string;
}
const {
  title = 'Brands Captain Clinton has worked with',
  lede = 'Over the years Captain Clinton has worked with some of the best-known names in Northwest fishing.',
} = Astro.props;

// A moving belt of logos. The track holds the logos twice over and slides right by exactly half its
// width, so the loop is seamless. With only four brands one pass is narrower than a wide screen,
// so each half repeats the set to fill it. Only the first set is exposed to screen readers.
const REPEAT = 2;
const half = Array.from({ length: REPEAT }, () => PARTNERS).flat();
const track = [...half, ...half];
---
<section class="pt" aria-labelledby="pt-h">
  <div class="wrap">
    <div class="pt__head" data-reveal="up">
      <p class="pt__tag">Past collaborators</p>
      <h2 id="pt-h">{title}</h2>
      <p class="pt__lede">{lede}</p>
    </div>
  </div>
  <div class="pt__belt">
    <ul class="pt__track">
      {track.map((p, i) => {
        const dup = i >= PARTNERS.length;
        return (
          <li aria-hidden={dup ? 'true' : undefined}>
            <a class="pt__card" href={p.url} target="_blank" rel="noopener noreferrer" tabindex={dup ? -1 : undefined} aria-label={`${p.name} (opens in a new tab)`}>
              <img src={p.logo} alt={dup ? '' : p.name} width={p.width} height={p.height} loading="lazy" decoding="async" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
