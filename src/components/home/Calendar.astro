---
import type { IconName } from '../../components/icons/paths';
import Icon from '../Icon.astro';
import '../../styles/home-mid.css';
import { MONTHS_FULL, SEASONS, SEASON_DISCLAIMER, TRIPS_START } from '../../data/seasons';

const months = MONTHS_FULL;
const iconOf: Record<string, string> = { steelhead: 'fishJump', chinook: 'fish', fall: 'fish', crab: 'crab' };
const rows = SEASONS.map((x) => ({ key: x.key === 'steelhead' ? 'steel' : x.key, name: x.name, s: x.start, e: x.end, icon: iconOf[x.key], note: x.note, light: x.light, approximate: x.approximate }));
const range = (st: number, en: number) => `${months[st - 1].slice(0, 3)} to ${months[en - 1].slice(0, 3)}`;
const now = new Date();
const today = (now.getMonth() + (now.getDate() - 0.5) / new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate()) / 12;
---
<section class="hm-cal" aria-labelledby="hm-cal-h" data-cal style={`--today:${today.toFixed(4)}`}>
  <div class="wrap">
    <div class="hm-cal__head">
      <h2 id="hm-cal-h" data-reveal="up">The fishing year at a glance</h2>
      <p class="hm-cal__start" data-reveal="up"><Icon name="calendar" size={22} /><span>Trips are scheduled from the <strong>{TRIPS_START.replace('the ', '')}</strong>.</span></p>
    </div>

    <div class="hm-cal__sheet" data-reveal="fade">
      <table class="hm-tbl">
        <caption class="sr-only">Guided fishing seasons by month. Winter steelhead runs January to April, spring and early-summer Chinook about April to July, fall salmon about September to November, and crab charters October to December. Salmon months are approximate.</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Season</span></th>
            {months.map((m) => (<th scope="col"><span class="sr-only">{m}</span><span class="hm-m-full" aria-hidden="true">{m.slice(0, 3)}</span><span class="hm-m-one" aria-hidden="true">{m[0]}</span></th>))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class={`hm-row hm-row--${r.key}`} style={`--s:${r.s};--e:${r.e};--i:${i}`}>
              <th scope="row">
                <div class="hm-row__in">
                <span class="hm-row__ic"><Icon name={r.icon as IconName} size={22} /></span>
                <span class="hm-row__t"><strong>{r.name}</strong><small>{range(r.s, r.e)}{r.note && <span class="hm-row__note"> · {r.note}</span>}</small></span>
                </div>
              </th>
              <td colspan="12">
                <div class="hm-track">
                  <span class="hm-bar"><span class="hm-bar__t" aria-hidden="true">{range(r.s, r.e)}</span><span class="sr-only">{months[r.s - 1]} through {months[r.e - 1]}{r.light ? ', lighter opportunity' : ''}</span></span>
                  <i class="hm-today" aria-hidden="true">{i === 0 && <b data-cal-label>Today</b>}</i>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="hm-cal__key"><span class="hm-key hm-key--solid"></span> Prime window <span class="hm-key hm-key--light"></span> Additional opportunity <span class="hm-cal__now" data-cal-now aria-live="polite"></span></p>
    <p class="hm-cal__key hm-cal__fine">{SEASON_DISCLAIMER}</p>
  </div>
</section>

<script>
  function initCal() {
    document.querySelectorAll<HTMLElement>('[data-cal]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const d = new Date();
      const dim = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
      root.style.setProperty('--today', ((d.getMonth() + (d.getDate() - 0.5) / dim) / 12).toFixed(4));
      const label = root.querySelector('[data-cal-label]');
      if (label) label.textContent = 'Today';
      const out = root.querySelector('[data-cal-now]');
      if (out) out.textContent = '';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.dataset.motion === 'reduce';
      if (reduce || !('IntersectionObserver' in window)) { root.classList.add('is-drawn'); return; }
      root.classList.add('hm-anim');
      const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { root.classList.add('is-drawn'); io.disconnect(); } }, { threshold: 0.3 });
      io.observe(root.querySelector('.hm-tbl')!);
    });
  }
  initCal();
  document.addEventListener('astro:page-load', initCal);
</script>
