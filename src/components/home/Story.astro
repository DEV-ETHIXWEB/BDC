---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { PHOTOS } from '../../data/photos';
import '../../styles/home-mid.css';

const stats = [
  { n: 45, suffix: '+', label: 'years fishing Oregon waters' },
  { n: 7, suffix: '', label: 'top rivers we fish' },
  { n: 6, suffix: '', label: 'guests on our largest boat' },
  { n: 2, suffix: '', label: 'boats, drift and power' },
];
---
<section class="hm-story" aria-labelledby="hm-story-h">
  <div class="wrap hm-story__grid">
    <div class="hm-collage" data-reveal="fade">
      <figure class="hm-collage__main" data-parallax="0.04">
        <Picture src={PHOTOS.guestsB} alt="Two anglers on a boat holding a fish" formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[360, 540, 720, 1080, 1440, 2160]} sizes="(min-width: 900px) 360px, 68vw" loading="lazy" />
      </figure>
      <figure class="hm-collage__coast" data-parallax="-0.06">
        <Picture src={PHOTOS.oregonCoast} alt="Rugged Oregon coastline" formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[280, 420, 560, 840, 1120, 1680]} sizes="(min-width: 900px) 270px, 52vw" loading="lazy" />
      </figure>
      <figure class="hm-collage__tag" data-parallax="-0.1">
        <Picture src={PHOTOS.chinookGloves} alt="Angler holding a fish" formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[180, 360, 540, 720, 1080]} sizes="(min-width: 900px) 180px, 34vw" loading="lazy" />
        <figcaption>Fresh catch</figcaption>
      </figure>
      <svg class="hm-collage__ring" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5"/><circle cx="60" cy="60" r="40" fill="none" stroke="currentColor" stroke-width="1"/></svg>
    </div>

    <div class="hm-story__text">
      <h2 id="hm-story-h" data-reveal="up">A captain who reads the water, not the clock</h2>
      <p class="hm-story__lead" data-reveal="up">Captain Clinton McCulloch, the owner and guide behind BDC Guide Service, has spent over 45 years fishing the waters of Oregon.</p>
      <p data-reveal="up">Known for his down-to-earth personality and patient approach, he connects easily with anglers of all experience levels. He focuses on smaller group sizes so every guest receives attention and guidance throughout the trip.</p>
      <blockquote class="hm-pull" data-reveal="up">
        <p><span>Smaller groups.</span> <span>A patient approach.</span> <span>Responsible fishing practices.</span></p>
      </blockquote>
      <a class="btn btn--primary" data-magnetic href="/captain-clinton-mcculloch-of-oregon">Meet Captain Clinton<Icon name="arrowRight" size={18} /></a>
    </div>

    <dl class="hm-stats" data-stagger>
      {stats.map((s) => (
        <div class="hm-stats__cell" data-reveal="up">
          <dt><span class="hm-stats__n" data-count={s.n} data-count-suffix={s.suffix || undefined}>{s.n}{s.suffix}</span></dt>
          <dd>{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
