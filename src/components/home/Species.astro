---
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { ICONS } from '../../components/icons/paths';
import { SPECIES } from '../../data/content';
import { PHOTOS } from '../../data/photos';
import '../../styles/home-mid.css';

const pick = (want: string, fallback: string) => ((ICONS as Record<string, unknown>)[want] ? want : fallback);
const bigIcon: Record<string, string> = {
  'chinook-salmon': pick('salmon', 'fish'),
  'steelhead-trout': pick('steelhead', 'fishJump'),
  'dungeness-crab': pick('dungenessCrab', 'crab'),
};
const scaleMax = 60;
const parse = (s: string) => s.match(/(\d+)\s*-\s*(\d+)/)?.slice(1).map(Number) ?? [0, scaleMax];
const short: Record<string, string> = { 'chinook-salmon': 'Chinook', 'steelhead-trout': 'Steelhead', 'dungeness-crab': 'Dungeness crab' };
const alts: Record<string, string> = {
  'chinook-salmon': 'Angler holding a large silver Chinook salmon',
  'steelhead-trout': 'Angler holding a fresh winter steelhead',
  'dungeness-crab': 'Bucket of fresh Dungeness crab',
};
---
<section class="hm-species" aria-labelledby="hm-sp-h" data-species>
  <div class="wrap">
    <div class="hm-species__head">
      <h2 id="hm-sp-h" data-reveal="up">Field guide to the catch</h2>
      <a class="hm-species__all" href="/oregon-fishing-species">All target species<Icon name="arrowRight" size={18} /></a>
    </div>

    <div class="hm-guide">
      <div class="hm-tabs" role="tablist" aria-label="Choose a species" aria-orientation="vertical" data-reveal="up">
        {SPECIES.map((s, i) => (
          <button type="button" role="tab" class="hm-tab" id={`hm-tab-${s.slug}`} aria-controls={`hm-panel-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <Icon name={bigIcon[s.slug] as any} size={30} />
            <span><strong>{short[s.slug]}</strong><em>{s.latin}</em></span>
          </button>
        ))}
      </div>

      <div class="hm-plates" data-reveal="scale">
        {SPECIES.map((s, i) => {
          const [lo, hi] = parse(s.length);
          return (
            <div class="hm-plate" role="tabpanel" id={`hm-panel-${s.slug}`} aria-labelledby={`hm-tab-${s.slug}`} tabindex="0" hidden={false} data-active={i === 0 ? 'true' : undefined}>
              <div class="hm-plate__art" aria-hidden="true">
                <Icon name={bigIcon[s.slug] as any} size={240} class="hm-plate__icon" />
                <span class="hm-plate__fig">Fig. {i + 1}</span>
              </div>
              <div class="hm-plate__body">
                <h3>{s.name}</h3>
                <p class="hm-plate__latin"><em>{s.latin}</em>, family {s.family}</p>

                <div class="hm-ruler" role="img" aria-label={`Typical length ${s.length}`}>
                  <div class="hm-ruler__bar"><span style={`left:${(lo / scaleMax) * 100}%;width:${Math.max(((hi - lo) / scaleMax) * 100, 3)}%`}></span></div>
                  <div class="hm-ruler__ticks">{[0, 10, 20, 30, 40, 50, 60].map((t) => (<i style={`left:${(t / scaleMax) * 100}%`}>{t}</i>))}</div>
                  <p class="hm-ruler__cap">Length {s.length} <span>·</span> Weight {s.weight}</p>
                </div>

                <dl class="hm-spec">
                  <div><dt>Season</dt><dd>{s.season}</dd></div>
                  <div><dt>Technique</dt><dd>{s.technique}</dd></div>
                  <div><dt>Habitat</dt><dd>{s.habitat}</dd></div>
                </dl>
                <p class="hm-plate__tip"><Icon name="sparkle" size={20} /><span><strong>Guide's tip.</strong> {s.tip}</span></p>
              </div>
              <figure class="hm-plate__photo">
                <Picture src={PHOTOS[s.photo as keyof typeof PHOTOS]} alt={alts[s.slug]} formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[220, 440, 660, 880, 1320]} sizes="220px" loading="lazy" />
              </figure>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function initSpecies() {
    document.querySelectorAll<HTMLElement>('[data-species]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
      const select = (i: number, focus = false) => {
        tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
        panels.forEach((p, k) => { if (k === i) { p.removeAttribute('hidden'); p.dataset.active = 'true'; } else { p.hidden = true; delete p.dataset.active; } });
        if (focus) tabs[i].focus();
      };
      root.classList.add('is-ready');
      select(0);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const n = tabs.length;
          const k = e.key;
          let to = -1;
          if (k === 'ArrowDown' || k === 'ArrowRight') to = (i + 1) % n;
          else if (k === 'ArrowUp' || k === 'ArrowLeft') to = (i - 1 + n) % n;
          else if (k === 'Home') to = 0;
          else if (k === 'End') to = n - 1;
          if (to >= 0) { e.preventDefault(); select(to, true); }
        });
      });
    });
  }
  initSpecies();
  document.addEventListener('astro:page-load', initSpecies);
</script>
