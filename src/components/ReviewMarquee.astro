---
import '../styles/gallery.css';
import Icon from './Icon.astro';
import { MANUAL_REVIEWS, REVIEW_SUMMARY } from '../data/reviews';

interface Props {
  /** Heading for the band. */
  title?: string;
  tag?: string;
  /** Show the "all reviews" link. Off on the reviews page itself. */
  link?: boolean;
}
const { title = 'What guests say.', tag = 'Guest reviews', link = true } = Astro.props;

// The track is rendered twice and slid by exactly half its width, so the loop joins seamlessly.
// With a handful of real reviews that reads as a continuous wall, which is the honest way to make
// a short list feel generous: the same real words come round again, and nothing claims a count
// that does not exist. The visible total below is the real one.
const items = MANUAL_REVIEWS.filter((r) => r.text.trim());

// The track is two identical halves and slides exactly one half, so the loop joins seamlessly.
// Each half has to be at least as wide as the widest screen it will run on, or the content runs
// out mid-travel and leaves a gap at the edge. Two cards is about 810px, which is narrower than a
// laptop, so the list is repeated until one half comfortably covers a wide display. A card is
// 390px plus a 16px gap, so this many cards clears 2600px.
const PER_CARD = 406;
const perHalf = Math.max(items.length, Math.ceil(2600 / PER_CARD));
const half = Array.from({ length: perHalf }, (_, i) => items[i % items.length]);
const loop = [...half, ...half];
const stars = (n = 5) => Array.from({ length: n });

// Cards in the band share a height and the text is clamped, so a review long enough to be cut needs
// somewhere to go. About nine lines fit in a card at this width.
const LONG = 420;
---
{items.length > 0 && (
  <section class="rm" aria-labelledby="rm-h">
    <div class="wrap rm__head">
      <p class="rm__tag" data-reveal="fade"><Icon name="star" size={18} />{tag}</p>
      <h2 id="rm-h" data-reveal="up">{title}</h2>
      <p class="rm__sum" data-reveal="fade">
        <span class="rm__stars" aria-hidden="true">{stars(5).map(() => <Icon name="star" size={18} />)}</span>
        <strong>{REVIEW_SUMMARY.rating.toFixed(1)}</strong>
        <span>from Google reviews</span>
      </p>
      {link && <a class="rm__all" href="/oregon-fishing-charter-reviews">Read the reviews<Icon name="arrowRight" size={18} /></a>}
    </div>

    <div class="rm__viewport" data-rm>
      <ul class="rm__track" style={`--rm-n:${loop.length}`}>
        {loop.map((r, i) => (
          <li class="rm__item" aria-hidden={i >= items.length ? 'true' : undefined}>
            <figure class="rm__card">
              <div class="rm__rating" role={r.rating ? 'img' : undefined} aria-label={r.rating ? `${r.rating} out of 5` : undefined}>
                {stars(r.rating ?? 5).map(() => <Icon name="star" size={16} />)}
              </div>
              <blockquote><p>{r.text}</p></blockquote>
              {r.text.length > LONG && (
                <a class="rm__more" href="/oregon-fishing-charter-reviews#all-reviews" tabindex={i >= items.length ? -1 : undefined}>Read the full review</a>
              )}
              <figcaption>
                <span class="rm__who">{r.name}</span>
                {r.when && <span class="rm__when">{r.when}</span>}
                {r.source === 'Google' && (
                  <span class="rm__src"><Icon name="checkCircle" size={14} />Verified on Google</span>
                )}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<script>
  // Duration scales with the number of cards so the speed stays the same however many there are,
  // and the animation only runs when the band is on screen.
  function startMarquee() {
    document.querySelectorAll<HTMLElement>('[data-rm]').forEach((vp) => {
      const track = vp.querySelector<HTMLElement>('.rm__track');
      if (!track || track.dataset.on) return;
      track.dataset.on = '1';
      const n = Number(track.style.getPropertyValue('--rm-n')) || track.children.length;
      track.style.setProperty('--rm-dur', `${Math.max(18, n * 7)}s`);
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => vp.classList.toggle('is-running', e.isIntersecting));
      }, { rootMargin: '120px' });
      io.observe(vp);
    });
  }
  startMarquee();
  document.addEventListener('astro:page-load', startMarquee);
</script>
