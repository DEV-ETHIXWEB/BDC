---
import '../styles/gallery.css';
import Icon from './Icon.astro';
import { MANUAL_REVIEWS, REVIEW_SUMMARY } from '../data/reviews';

interface Props {
  /** Heading for the band. */
  title?: string;
  tag?: string;
  /** Show the "all reviews" link. Off on the reviews page itself. */
  link?: boolean;
}
const { title = 'What guests say.', tag = 'Guest reviews', link = true } = Astro.props;

// Each review is shown exactly once. It used to be a scrolling wall that repeated the list to fill
// wide screens, but with a handful of reviews the same names came round again and again, which
// read as duplicates. A plain row of real reviews is more believable than a busy loop.
const items = MANUAL_REVIEWS.filter((r) => r.text.trim());
const stars = (n = 5) => Array.from({ length: n });

// Cards in the band share a height and the text is clamped, so a review long enough to be cut needs
// somewhere to go. About nine lines fit in a card at this width.
const LONG = 420;
---
{items.length > 0 && (
  <section class="rm" aria-labelledby="rm-h">
    <div class="wrap rm__head">
      <p class="rm__tag" data-reveal="fade"><Icon name="star" size={18} />{tag}</p>
      <h2 id="rm-h" data-reveal="up">{title}</h2>
      <p class="rm__sum" data-reveal="fade">
        <span class="rm__stars" aria-hidden="true">{stars(5).map(() => <Icon name="star" size={18} />)}</span>
        <strong>{REVIEW_SUMMARY.rating.toFixed(1)}</strong>
        <span>from Google reviews</span>
      </p>
      {link && <a class="rm__all" href="/oregon-fishing-charter-reviews">Read the reviews<Icon name="arrowRight" size={18} /></a>}
    </div>

    <div class="wrap rm__viewport">
      <ul class="rm__track">
        {items.map((r) => (
          <li class="rm__item">
            <figure class="rm__card">
              <div class="rm__rating" role={r.rating ? 'img' : undefined} aria-label={r.rating ? `${r.rating} out of 5` : undefined}>
                {stars(r.rating ?? 5).map(() => <Icon name="star" size={16} />)}
              </div>
              <blockquote><p>{r.text}</p></blockquote>
              {r.text.length > LONG && (
                <a class="rm__more" href="/oregon-fishing-charter-reviews#all-reviews">Read the full review</a>
              )}
              <figcaption>
                <span class="rm__who">{r.name}</span>
                {r.when && <span class="rm__when">{r.when}</span>}
                {r.source === 'Google' && (
                  <span class="rm__src"><Icon name="checkCircle" size={14} />Verified on Google</span>
                )}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

