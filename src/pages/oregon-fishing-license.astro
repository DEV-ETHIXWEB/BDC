---
import '../styles/pages.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Fishing License', path: '/oregon-fishing-license' }];
---
<Base title="Get Your Valid Oregon Fishing License" description="An Oregon fishing license is required for anglers 12 and older on BDC Guide Service trips. Here is how to get yours from the Oregon Department of Fish & Wildlife." crumbs={crumbs}>
  <PageHero title="Get your Oregon fishing license" lede="Required for anyone 12 or older. Sort it before your trip." crumbs={crumbs} tag="Trip prep" seed={14} edge="sand">
    <div slot="art" class="pg-age"><span class="pg-age__n"><span data-count="12">12</span>+</span><small>age when a license is required</small></div>
  </PageHero>
  <section class="pg-lic">
    <div class="wrap pg-lic__grid">
      <ol class="pg-route">
        <li data-reveal="up">
          <span class="pg-route__node" aria-hidden="true">1</span>
          <h2>Check who needs one</h2>
          <p>Yes, you need a license. A valid Oregon fishing license is required for anyone aged 12 or older.</p>
        </li>
        <li data-reveal="up">
          <span class="pg-route__node" aria-hidden="true">2</span>
          <h2>Buy it from ODFW</h2>
          <p>Licenses are issued by the Oregon Department of Fish &amp; Wildlife (ODFW). Buy online, or at licensed retailers.</p>
          <p><a class="btn btn--primary" href={SITE.licenseUrl} rel="noopener" target="_blank">Purchase at ODFW<Icon name="arrowUpRight" size={18} /></a></p>
        </li>
        <li data-reveal="up">
          <span class="pg-route__node" aria-hidden="true">3</span>
          <h2>Check for endorsements</h2>
          <p>Some waters and species need extra endorsements, so check the current rules for your trip.</p>
        </li>
        <li data-reveal="up">
          <span class="pg-route__node" aria-hidden="true">4</span>
          <h2>Not sure what you need?</h2>
          <p>Call Captain Clinton at <a href={SITE.phoneHref}>{SITE.phone}</a> and he will point you to the right license for your trip.</p>
        </li>
      </ol>
      <aside class="pg-lic__card" data-reveal="up">
        <Icon name="license" size={44} />
        <h3>The short version</h3>
        <ul class="list">
          <li><Icon name="checkCircle" size={20} />Anglers 12 and older need a license</li>
          <li><Icon name="checkCircle" size={20} />ODFW issues it, online or at retailers</li>
          <li><Icon name="checkCircle" size={20} />Some waters need extra endorsements</li>
        </ul>
        <a class="btn btn--green btn--sm" href={SITE.licenseUrl} rel="noopener" target="_blank">myodfw.com<Icon name="arrowUpRight" size={16} /></a>
      </aside>
    </div>
  </section>
  <CtaBand />
</Base>
