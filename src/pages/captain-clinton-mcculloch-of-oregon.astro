---
import { Picture } from 'astro:assets';
import '../styles/pages.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Crest from '../components/art/Crest.astro';
import BoatWilly from '../components/art/BoatWilly.astro';
import BoatDrift from '../components/art/BoatDrift.astro';
import { PHOTOS } from '../data/photos';
import { SITE, RIVERS } from '../data/site';
const crumbs = [{ name: 'Meet the Captain', path: '/captain-clinton-mcculloch-of-oregon' }];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.captain,
  jobTitle: 'Fishing guide and charter captain',
  worksFor: { '@id': `${SITE.url}/#business` },
  url: `${SITE.url}/captain-clinton-mcculloch-of-oregon`,
};
const principles = [
  { icon: 'users', title: 'Smaller groups', body: 'He focuses on smaller group sizes to ensure every guest receives attention and guidance throughout the trip.' },
  { icon: 'sparkle', title: 'Patient approach', body: 'A down-to-earth personality that connects easily with anglers of all experience levels.' },
  { icon: 'shield', title: 'Responsible fishing', body: 'He promotes responsible fishing practices and respects the natural environment.' },
  { icon: 'rod', title: 'Gear provided', body: 'Rods, reels and tackle are included, plus live bait when applicable.' },
  { icon: 'camera', title: 'Photos and videos', body: 'Clients receive photos and videos to relive the day long after it ends.' },
  { icon: 'calendar', title: 'Tailored, safety first', body: 'Every trip is tailored to the season, river conditions and your skill level. Safety is always a priority.' },
] as const;
const facts = [
  { n: 45, s: '+', l: 'years fishing Oregon waters' },
  { n: RIVERS.length, s: '', l: 'rivers on our list' },
  { n: 2, s: '', l: 'boats: one for big water, one for shallow' },
  { n: 3, s: '', l: 'targets: salmon, steelhead and Dungeness crab' },
];
const willy = [
  ['Main engine', '150 HP main engine, one of the twin Yamaha motors.'],
  ['Kicker', '9.9 HP kicker for precise trolling.'],
  ['Seating', 'Up to 6 anglers, often limited to 4 for comfort.'],
  ['Comfort', 'Both boats are equipped for comfort and efficiency.'],
  ['Home water', 'Ideal for salmon fishing on larger rivers, and versatile enough for multiple fisheries throughout the year.'],
];
const drift = [
  ['Shallow water', 'A 16-foot drift boat designed for smooth navigation in shallow water.'],
  ['Seating', 'Up to 3 guests for a more personal experience.'],
  ['Comfort', 'Both boats are equipped for comfort and efficiency.'],
  ['Home water', 'Used for smaller rivers and winter steelhead trips.'],
];
---
<Base title="Meet Captain Clinton McCulloch" description="Captain Clinton McCulloch has fished Oregon waters for 45+ years. Meet the guide behind BDC Guide Service and see the Willy Predator and Alumaweld drift boat." crumbs={crumbs} schema={[person]}>
  <PageHero title="Meet Captain Clinton" lede="Over 45 years fishing the waters of Oregon." crumbs={crumbs} tag="Owner and guide" seed={7}>
    <Crest slot="art" />
  </PageHero>

  <section class="pg-cap">
    <div class="wrap pg-cap__grid">
      <figure class="pg-specimen" data-reveal="up">
        <div class="pg-specimen__img">
          <Picture src={PHOTOS.oregonCoast} alt="Rugged Oregon coastline framed by a windswept tree" formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[320, 480, 560, 840, 1120, 1680]} sizes="(min-width: 900px) 420px, min(86vw, 420px)" loading="eager" />
        </div>
        <figcaption><Icon name="pin" size={16} />The Oregon coast</figcaption>
      </figure>
      <div class="pg-editorial">
        <p class="pg-dropcap" data-reveal="up">Captain Clinton McCulloch, the owner and guide behind BDC Guide Service, has spent over 45 years fishing the waters of Oregon. What began as a lifelong passion quickly turned into a way of life, shaped by early days on local rivers and countless seasons chasing salmon and steelhead.</p>
        <p class="pg-pull" data-reveal="up">Known for his down-to-earth personality and patient approach, Captain Clinton connects easily with anglers of all experience levels.</p>
        <p data-reveal="up">He focuses on smaller group sizes to ensure every guest receives attention and guidance throughout the trip. He also provides photos and videos so clients can relive their experience long after the day ends. Safety is always a priority, and every trip is carefully planned around weather, water conditions, and guest experience.</p>
        <p data-reveal="up">With a strong appreciation for Oregon's fisheries, he promotes responsible fishing practices and respects the natural environment that makes these waters so special.</p>
      </div>
    </div>
  </section>

  <section class="pg-tide" aria-label="Captain at a glance">
    <div class="wrap">
      <dl class="pg-tide__row" data-stagger>
        {facts.map((f) => (
          <div data-reveal="up">
            <dt><span class="pg-tide__n"><span data-count={f.n} data-count-suffix={f.s}>{f.n}{f.s}</span></span></dt>
            <dd>{f.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="pg-principles">
    <div class="wrap pg-principles__grid">
      <div class="pg-principles__head" data-reveal="up">
        <h2>How every trip runs</h2>
        <p class="lede">Clinton brings the boat, the gear and over 45 years fishing the waters of Oregon.</p>
      </div>
      <ul class="pg-rules" data-stagger>
        {principles.map((p) => (
          <li data-reveal="up">
            <span class="pg-rules__ic"><Icon name={p.icon} size={26} /></span>
            <div><h3>{p.title}</h3><p>{p.body}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pg-boats" id="boats">
    <div class="wrap">
      <div class="pg-boats__head" data-reveal="up">
        <h2>Two boats, two kinds of water</h2>
        <p class="lede">The two boats, as described by Captain Clinton.</p>
      </div>
      <div class="pg-boats__grid">
        <figure class="pg-sheet">
          <div class="pg-sheet__title"><h3>Willy Predator</h3><span>22 ft, twin outboard</span></div>
          <BoatWilly />
          <figcaption>
            <ol class="pg-legend">{willy.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ol>
          </figcaption>
        </figure>
        <figure class="pg-sheet">
          <div class="pg-sheet__title"><h3>Alumaweld Guide Model</h3><span>16 ft drift boat</span></div>
          <BoatDrift />
          <figcaption>
            <ol class="pg-legend">{drift.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ol>
          </figcaption>
        </figure>
      </div>
      <p class="pg-boats__more"><a class="btn btn--cream" href="/oregon-fishing-charter-rates">Choose your boat and trip<Icon name="arrowRight" size={18} /></a></p>
    </div>
  </section>
  <CtaBand />
</Base>
