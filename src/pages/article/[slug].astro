---
import '../../styles/pages.css';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import TocSpy from '../../components/pg/TocSpy.astro';
import { SITE } from '../../data/site';
import { longDate } from '../../data/articles';
import { fileGitDate } from '../../../scripts/page-dates.mjs';

// Markdown posts from src/content/blog. The two original articles are static .astro files at
// /article/<slug>, and a static route always beats this dynamic one, so their URLs stay as they were.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    // dateModified has to mean "when this text last changed", so it comes from the last commit that
    // touched the file. The author's own `updated:` wins when they set one, because that is the
    // claim the page itself makes. Recency is what AI answers and recrawl scheduling reward, and a
    // date that quietly tracked the build would be a lie told on every deploy.
    props: { post, modified: post.data.updated || fileGitDate(`src/content/blog/${post.id}.md`) },
  }));
}

const { post, modified } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, published, updated, tag, draft } = post.data;

const crumbs = [
  { name: 'Articles', path: '/article' },
  { name: title, path: `/article/${post.id}` },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  ...(modified ? { dateModified: new Date(modified).toISOString() } : {}),
  author: { '@type': 'Organization', name: SITE.name, '@id': `${SITE.url}/#business` },
  publisher: { '@id': `${SITE.url}/#business` },
  mainEntityOfPage: `${SITE.url}/article/${post.id}`,
};
// "On this page" is built from h2s. A post that carries its structure in h3s under one or two h2s
// (a numbered list of questions, say) would otherwise get no contents at all, which is exactly the
// post that needs one, so those fall back to h3s. Capped, because a 20-entry list is not a summary.
const h2s = headings.filter((h) => h.depth === 2 && h.slug);
const toc = (h2s.length >= 3 ? h2s : headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug)).slice(0, 12);
// 220 wpm is the usual reading-speed figure for web prose. Rounded up, because nobody finishes a
// post in 0 minutes, and shown so a reader can judge the length before starting.
const minutes = Math.max(1, Math.round((post.body ?? '').trim().split(/\s+/).filter(Boolean).length / 220));
---
<Base title={title} description={description} crumbs={crumbs} schema={[schema]} type="article" noindex={draft}>
  <PageHero title={title} lede={description} crumbs={crumbs} tag={tag} seed={11} />
  <div class:list={['wrap', 'pg-article', toc.length > 2 ? 'pg-article--toc' : 'pg-article--solo']}>
    {toc.length > 2 && (
      <aside class="pg-toc" aria-label="On this page">
        <details class="pg-toc__d" open>
          <summary>On this page</summary>
          <nav data-pg-spy>
            <ol>{toc.map((h) => <li class:list={[h.depth === 3 && 'is-sub']}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        </details>
      </aside>
    )}
    <article class="pg-prose pg-prose--md">
      <p class="pg-byline">
        <span class="pg-byline__by">By <a href="/captain-clinton-mcculloch-of-oregon">{SITE.name}</a></span>
        <time datetime={published}>{longDate(published)}</time>
        <span class="pg-byline__read">{minutes} min read</span>
        {updated && <span class="pg-byline__upd">Updated <time datetime={updated}>{longDate(updated)}</time></span>}
      </p>
      {draft && <p class="pg-draft" role="status">Draft. This post is not listed or indexed yet.</p>}
      <Content />
      <aside class="pg-callout" data-reveal="up">
        <Icon name="boat" size={32} />
        <div><h3>Plan a day on the water</h3><p>See the available trips and rates.</p></div>
        <a class="btn btn--primary btn--sm" href="/oregon-fishing-charter-rates">See trips</a>
      </aside>
    </article>
  </div>
  <TocSpy />
</Base>
