---
import '../styles/gallery.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { type Review } from '../components/ReviewWall.astro';
import GoogleReviews from '../components/react/GoogleReviews';
import { SITE } from '../data/site';
import ReviewMarquee from '../components/ReviewMarquee.astro';
import { MANUAL_REVIEWS, REVIEW_SUMMARY } from '../data/reviews';
const crumbs = [{ name: 'Reviews', path: '/oregon-fishing-charter-reviews' }];
// Reviews reach this page two ways. Anything added to this array is published by hand, with the guest's
// permission. Google reviews arrive on their own through /api/reviews once a Place ID and key are set, and
// the invitation below hides itself as soon as any turn up.
// No AggregateRating markup is emitted until there are genuine, verifiable reviews on the page.
// Real reviews, transcribed from the Google Business Profile. The marquee loops them at the top of
// the page; the wall below shows each one once.
const reviews: Review[] = MANUAL_REVIEWS.filter((r) => r.text.trim()).map((r) => ({
  name: r.name, trip: r.trip ?? '', text: r.text, rating: r.rating, date: r.when, where: r.source,
}));

// Now that there are real, checkable reviews on a public profile, the rating markup is honest.
// It stays tied to REVIEW_SUMMARY so it can never drift from what the profile actually shows.
const ratingSchema = REVIEW_SUMMARY.total > 0 ? [{
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: REVIEW_SUMMARY.rating,
    reviewCount: REVIEW_SUMMARY.total,
    bestRating: 5,
    worstRating: 1,
  },
  review: reviews.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    reviewRating: { '@type': 'Rating', ratingValue: r.rating ?? 5, bestRating: 5, worstRating: 1 },
    reviewBody: r.text,
  })),
}] : [];
const body = encodeURIComponent('Hi Captain Clinton,\n\nTrip I took (salmon, steelhead or crab):\nApproximate date:\nWhat stood out:\n\nMy name as I would like it shown:\nOK to publish this review on your website? (yes/no)\n');
---
<Base title="Oregon Fishing Charter Reviews" description="Guest reviews for BDC Guide Service fishing and crabbing charters in Oregon, rated 5.0 on Google. Been on a trip? Send us a few lines." crumbs={crumbs} schema={ratingSchema}>
  <PageHero title="Guest reviews" lede="Rated 5.0 on Google. Here is what guests say after a day on the water with Captain Clinton." crumbs={crumbs} />
  <ReviewMarquee title="Straight from the boat." link={false} />
  <section class="section gb-reviews" style="padding-top:0">
    <div class="wrap">
      <GoogleReviews client:load />
      <div class="gb-invite" id="gb-invite">
          <div class="gb-invite__copy">
            <h2 data-reveal="up">Been out with Captain Clinton?</h2>
            <p data-reveal="fade">Send a few lines about your trip and, with your OK, we will add it here. Reviews on Google help other anglers find the boat.</p>
            <div class="gb-invite__actions" data-reveal="fade">
              <a class="btn btn--primary" data-magnetic href={`mailto:${SITE.email}?subject=${encodeURIComponent('My BDC trip review')}&body=${body}`}><Icon name="mail" size={18} />Email your review</a>
              <a class="btn btn--ghost gb-invite__call" href={SITE.phoneHref}><Icon name="phone" size={18} />{SITE.phone}</a>
            </div>
          </div>
          <aside class="gb-slip" aria-label="What to include in your review" data-reveal="scale">
            <p class="gb-slip__title">Guest book slip</p>
            <dl>
              <div><dt>Trip</dt><dd>Which trip you took</dd></div>
              <div><dt>Date</dt><dd>Roughly when you fished</dd></div>
              <div><dt>Story</dt><dd>What you caught, what you'll remember</dd></div>
              <div><dt>Name</dt><dd>As you'd like it shown</dd></div>
            </dl>
            <p class="gb-slip__note">Reviews are published only with the guest's permission.</p>
          </aside>
      </div>
    </div>
  </section>
</Base>
