---
import { Picture } from 'astro:assets';
import '../styles/pages.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import TocSpy from '../components/pg/TocSpy.astro';
import ContourPattern from '../components/art/ContourPattern.astro';
import { PHOTOS } from '../data/photos';
import { SPECIES } from '../data/content';
import { season, monthsOf, MONTHS_FULL, SEASON_DISCLAIMER } from '../data/seasons';
const crumbs = [{ name: 'Target Species', path: '/oregon-fishing-species' }];
const MONTHS = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const MONTH_NAMES = [...MONTHS_FULL];
const CAL: Record<string, { main: number[]; alt?: number[]; mainLabel: string; altLabel?: string; rivers: string[]; short: string }> = {
  'chinook-salmon': { main: monthsOf(season('chinook')), alt: monthsOf(season('fall')), mainLabel: 'Spring and early summer (approx.)', altLabel: 'Fall, more chances (approx.)', rivers: ['Columbia River', 'Willamette River'], short: 'Chinook' },
  'steelhead-trout': { main: monthsOf(season('steelhead')), mainLabel: 'January through April', rivers: ['Wilson River', 'Trask River', 'Sandy River', 'Clackamas River', 'Nestucca River'], short: 'Steelhead' },
  'dungeness-crab': { main: monthsOf(season('crab')), mainLabel: 'October through December', rivers: [], short: 'Crab' },
};
---
<Base title="Oregon Fishing Species" description="Learn about the fish and shellfish we target in Oregon: Chinook salmon, winter steelhead and Dungeness crab. Sizes, seasons, best techniques and rivers." crumbs={crumbs}>
  <PageHero title="Oregon target species" lede="What's biting, when, and how we catch it." crumbs={crumbs} tag="Field guide" seed={12} edge="page">
    <div slot="art" class="pg-trio">
      <span class="pg-trio__a"><Icon name="fish" size={96} /></span>
      <span class="pg-trio__b"><Icon name="fishJump" size={96} /></span>
      <span class="pg-trio__c"><Icon name="crab" size={96} /></span>
    </div>
  </PageHero>

  <div class="wrap pg-sp">
    <nav class="pg-sp__nav" aria-label="Jump to a species" data-pg-spy>
      <ul>
        {SPECIES.map((s) => <li><a href={`#${s.slug}`}><Icon name={s.icon} size={20} /><span>{CAL[s.slug].short}</span></a></li>)}
      </ul>
    </nav>
    <div class="pg-sp__plates">
      {SPECIES.map((s, i) => {
        const c = CAL[s.slug];
        return (
          <article class="pg-plate" id={s.slug} aria-labelledby={`${s.slug}-h`}>
            <header class="pg-plate__head">
              <div class="pg-plate__art" data-reveal="scale">
                <ContourPattern class="pg-plate__contour" seed={i * 5 + 2} rings={9} centers={1} />
                <Icon name={s.icon} size={150} />
              </div>
              <div class="pg-plate__id">
                <h2 id={`${s.slug}-h`} data-reveal="up">{s.name}</h2>
                <p class="pg-plate__latin">{s.latin}<span>Family {s.family}</span></p>
              </div>
            </header>
            <div class="pg-plate__body">
              <div class="pg-plate__data">
                <dl class="pg-vitals" data-stagger>
                  {s.weight && <div data-reveal="up"><dt>Weight</dt><dd>{s.weight}</dd></div>}
                  {s.length && <div data-reveal="up"><dt>Length</dt><dd>{s.length}</dd></div>}
                  {s.habitat && <div data-reveal="up"><dt>Habitat</dt><dd class="pg-vitals__txt">{s.habitat}</dd></div>}
                </dl>
                <div class="pg-season" role="img" aria-label={`Season: ${c.mainLabel}${c.altLabel ? `; ${c.altLabel}` : ''}`}>
                  <div class="pg-season__bar" data-reveal="line">
                    {MONTHS.map((m, k) => (
                      <span class:list={[c.main.includes(k) && 'is-on', c.alt?.includes(k) && 'is-alt']} title={MONTH_NAMES[k]}>{m}</span>
                    ))}
                  </div>
                  <p class="pg-season__key"><i class="k-on"></i>{c.mainLabel}{c.altLabel && <><i class="k-alt"></i>{c.altLabel}</>}</p>
                </div>
                <p class="pg-plate__season">{s.season}</p>
                {c.altLabel && <p class="pg-plate__fine">{SEASON_DISCLAIMER}</p>}
              </div>
              <div class="pg-plate__notes">
                <div class="pg-plate__photo" data-reveal="up">
                  <Picture src={PHOTOS[s.photo]} alt={`${s.name}: angler with a catch`} formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[240, 360, 480, 720, 960, 1440]} sizes="(min-width: 900px) 240px, 46vw" loading="lazy" />
                </div>
                <div class="pg-note">
                  <h3>Technique</h3>
                  <p>{s.technique}</p>
                </div>
                <div class="pg-note pg-note--tip">
                  <h3>Good to know</h3>
                  <p>{s.tip}</p>
                </div>
              </div>
            </div>
            {c.rivers.length > 0 && (
              <footer class="pg-plate__rivers">
                <h3>Where we fish it</h3>
                <ul>{c.rivers.map((r) => <li><Icon name="wave" size={16} />{r}</li>)}</ul>
              </footer>
            )}
          </article>
        );
      })}
    </div>
  </div>
  <TocSpy />
  <CtaBand title="Pick your species, pick your trip" />
</Base>
