---
import '../styles/pages.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TocSpy from '../components/pg/TocSpy.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Privacy Policy', path: '/privacy-policy' }];
const toc = [['collect', 'What we collect'], ['how', 'How your request reaches us'], ['storage', 'What stays in your browser'], ['tracking', 'Tracking and third parties'], ['contact', 'Contact']];
---
<Base title="Privacy Policy" description="How BDC Guide Service handles the personal information you send when you contact us or request a fishing trip, and what this website stores in your browser." crumbs={crumbs}>
  <PageHero title="Privacy policy" crumbs={crumbs} tag="Your information" seed={19} />
  <div class="wrap pg-article pg-legal">
    <aside class="pg-toc" aria-label="On this page">
      <details class="pg-toc__d" open>
        <summary>On this page</summary>
        <nav data-pg-spy><ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol></nav>
      </details>
    </aside>
    <article class="pg-prose">
      <p>Last updated September 19, 2026. This page describes what this website does with your information.</p>
      <section id="collect"><h2>What we collect</h2>
        <p>Only what you type into the trip request form or the contact form at the bottom of each page when you submit it: your name, phone number, email address, the trip you chose, number of guests and preferred date (trip request form), your question (contact form, together with the page you sent it from) and any message. If you email or call us directly, we have the details you share with us.</p></section>
      <section id="how"><h2>How your request reaches us</h2>
        <p>When you submit either form, it is sent to {SITE.name} by a form service, or, if that is not available, your email app opens with your request filled in and you send it yourself. We use your details to answer your questions and arrange your trip.</p>
        <p>The chat assistant answers from the information on this website and runs in your browser. Messages you type into it are not sent to us or to any server.</p></section>
      <section id="storage"><h2>What stays in your browser</h2>
        <p>Your accessibility choices (text size, contrast, links, motion, font, cursor) are saved in your browser's local storage so they apply on your next visit. Your chat conversation is kept in your browser's session storage and disappears when you close the tab. Neither is sent anywhere.</p></section>
      <section id="tracking"><h2>Tracking and third parties</h2>
        <p>This website sets no cookies, has no analytics or advertising trackers, and loads its fonts and images from its own server.</p></section>
      <section id="contact"><h2>Contact</h2>
        <p>{SITE.name}, {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postal}. <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p></section>
    </article>
  </div>
  <TocSpy />
</Base>
