---
import '../styles/pages.css';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import TocSpy from '../components/pg/TocSpy.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Things To Do', path: '/things-to-do-in-oregon' }];
const article = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Things To Do In Oregon', datePublished: '2026-07-10', author: { '@type': 'Person', name: 'Clinton McCulloch' }, publisher: { '@id': `${SITE.url}/#business` } };
const toc = [
  ['parks', 'Scenic state parks and trails'],
  ['gorge', 'The Columbia River Gorge'],
  ['dining', 'Local dining and fresh seafood'],
  ['towns', 'Small-town charm'],
  ['family', 'Family-friendly outdoor activities'],
];
---
<Base title="Things To Do In Oregon" description="A guide to the top things to do in Oregon: scenic state parks, the Columbia River Gorge, fresh seafood, small-town charm and family-friendly outdoor activities." crumbs={crumbs} schema={[article]} type="article">
  <PageHero title="Things to do in Oregon" lede="Outdoor adventures, local attractions and family-friendly activities, by Clinton McCulloch." crumbs={crumbs} tag="Visitor guide" seed={9} />
  <div class="wrap pg-article">
    <aside class="pg-toc" aria-label="On this page">
      <details class="pg-toc__d" open>
        <summary>On this page</summary>
        <nav data-pg-spy>
          <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
        </nav>
      </details>
    </aside>
    <article class="pg-prose">
      <p class="pg-byline"><span class="pg-byline__by">By Clinton McCulloch</span><time datetime="2026-07-10">July 10, 2026</time></p>

      <section id="parks" data-reveal="up">
        <h2><span class="pg-h-ic"><Icon name="mountain" size={22} /></span>Explore Oregon's scenic state parks and trails</h2>
        <p class="pg-dropcap">Oregon showcases remarkable natural beauty through its state parks. Silver Falls State Park and the Columbia River Gorge offer extensive hiking trails, cascading waterfalls and expansive vistas, with picnic facilities and accessible paths for all ages.</p>
      </section>

      <section id="gorge" data-reveal="up">
        <h2><span class="pg-h-ic"><Icon name="compass" size={22} /></span>Visit the Columbia River Gorge</h2>
        <p>One of Oregon's most recognizable attractions, the Gorge features dramatic cliffs and waterfalls. Multnomah Falls is the most celebrated. Take a scenic route, stop at viewpoints, or hike a short trail.</p>
        <p class="pg-pull">It pairs well with a day on the water before or after your fishing trip.</p>
      </section>

      <section id="dining" data-reveal="up">
        <h2><span class="pg-h-ic"><Icon name="crab" size={22} /></span>Enjoy local dining and fresh seafood</h2>
        <p>Oregon's food scene favors fresh, regional ingredients. Coastal and river towns have everything from casual fish markets to fine dining.</p>
      </section>

      <section id="towns" data-reveal="up">
        <h2><span class="pg-h-ic"><Icon name="pin" size={22} /></span>Discover Oregon's small-town charm</h2>
        <p>Smaller communities, especially near Clackamas and along river corridors, offer boutique shops, neighborhood eateries and welcoming locals.</p>
      </section>

      <section id="family" data-reveal="up">
        <h2><span class="pg-h-ic"><Icon name="users" size={22} /></span>Family-friendly outdoor activities</h2>
        <p>Nature walks, wildlife watching, picnics and scenic drives work for every age and skill level, and so does a guided <a href="/oregon-fishing-charter-rates">fishing trip</a>.</p>
      </section>

      <aside class="pg-callout" data-reveal="up">
        <Icon name="boat" size={32} />
        <div><h3>Add a day on the water</h3><p>Half-day and full-day trips are available. We meet guests in Happy Valley.</p></div>
        <a class="btn btn--primary btn--sm" href="/oregon-fishing-charter-rates">See trips</a>
      </aside>
    </article>
  </div>
  <TocSpy />
  <CtaBand />
</Base>
