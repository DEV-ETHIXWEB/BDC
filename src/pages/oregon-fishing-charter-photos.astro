---
import '../styles/gallery.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import GalleryWall from '../components/react/GalleryWall';
import * as P from '../data/photos';
const { PHOTOS, GALLERY } = P;
const META: Record<string, { maxDisplay?: number }> = (P as any).PHOTO_META ?? {};
const crumbs = [{ name: 'Gallery', path: '/oregon-fishing-charter-photos' }];

const CAT: Record<string, string> = {
  chinookLake: 'Salmon', salmonSeated: 'Salmon', salmonTeal: 'Salmon', chinookGloves: 'Salmon', salmonOnBoat: 'Salmon',
  winterSteelhead: 'Steelhead', steelheadRiverbank: 'Steelhead', steelheadBlue: 'Steelhead', steelheadDrift: 'Steelhead',
  dungenessCrab: 'Crab',
};
const cats = ['Salmon', 'Steelhead', 'Crab', 'On the water'];

const items = await Promise.all(
  GALLERY.map(async (g) => {
    const m = PHOTOS[g.key];
    const maxDisplay = META[g.key]?.maxDisplay ?? 560;
    const tw = [360, 540, 720, 1080].map((w) => Math.min(w, m.width));
    const thumbs = await Promise.all(tw.map((w) => getImage({ src: m, width: w, format: 'avif', quality: 66 })));
    const fw = [maxDisplay, Math.round(maxDisplay * 1.5), maxDisplay * 2].map((w) => Math.min(w, m.width));
    const fulls = await Promise.all(fw.map((w) => getImage({ src: m, width: w, format: 'webp' })));
    const t = thumbs[1];
        return {
      id: g.key,
      alt: g.alt,
      caption: g.caption,
      cat: CAT[g.key] ?? 'On the water',
      ratio: m.width / m.height,
      thumb: { src: t.src, srcset: thumbs.map((x, i) => `${x.src} ${tw[i]}w`).join(', '), width: Number(t.attributes.width), height: Number(t.attributes.height) },
      full: { src: fulls[0].src, srcset: fulls.map((x, i) => `${x.src} ${fw[i]}w`).join(', '), width: Number(fulls[0].attributes.width), height: Number(fulls[0].attributes.height), maxDisplay },
    };
  }),
);
---
<Base title="Oregon Fishing Charter Photos" description="Photos from BDC Guide Service trips: Chinook salmon, winter steelhead, Dungeness crab and happy guests on the Columbia, Willamette and Oregon coastal rivers." crumbs={crumbs}>
  <PageHero title="Trip gallery" lede="Real guests, real fish, real Oregon water." crumbs={crumbs} />
  <section class="gb-gallery section" style="padding-top:0">
    <div class="wrap">
      <GalleryWall client:load items={items} cats={cats} />
    </div>
  </section>
  <CtaBand title="Want to be in the next photo?" />
</Base>
